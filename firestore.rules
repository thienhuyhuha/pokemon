rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // 3. PlayerProfile Validation Blueprint (Anti-Update-Gap)
    function isValidPlayerProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'highestUnlockedLevel',
          'totalScore',
          'soundEnabled',
          'levels',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'highestUnlockedLevel',
          'totalScore',
          'soundEnabled',
          'levels',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.highestUnlockedLevel is int
        && data.highestUnlockedLevel >= 1
        && data.highestUnlockedLevel <= 200
        && data.totalScore is int
        && data.totalScore >= 0
        && data.totalScore <= 500000000
        && data.soundEnabled is bool
        && data.levels is map
        && data.levels.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Action Helpers for PlayerProfile Update
    function isImmutableProfilePreserved() {
      return incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }

    function isSoundToggleAction() {
      return isImmutableProfilePreserved()
        && incoming().diff(existing()).affectedKeys().hasOnly(['soundEnabled', 'updatedAt']);
    }

    function isProfileSyncAction() {
      return isImmutableProfilePreserved()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'updatedAt'
        ]);
    }

    function isProgressUpdateAction() {
      return isImmutableProfilePreserved()
        && incoming().highestUnlockedLevel >= existing().highestUnlockedLevel
        && incoming().highestUnlockedLevel <= incoming().levels.size() + 1
        && incoming().totalScore >= existing().totalScore
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'highestUnlockedLevel',
          'totalScore',
          'levels',
          'updatedAt'
        ]);
    }

    // 4. DiamondProfile Validation Blueprint (Kim Cương 100)
    function isValidDiamondProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'highestUnlockedLevel',
          'totalScore',
          'levels',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'highestUnlockedLevel',
          'totalScore',
          'levels',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.highestUnlockedLevel is int
        && data.highestUnlockedLevel >= 1
        && data.highestUnlockedLevel <= 100
        && data.totalScore is int
        && data.totalScore >= 0
        && data.totalScore <= 500000000
        && data.levels is map
        && data.levels.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isDiamondProgressUpdateAction() {
      return isImmutableProfilePreserved()
        && incoming().highestUnlockedLevel >= existing().highestUnlockedLevel
        && incoming().highestUnlockedLevel <= incoming().levels.size() + 1
        && incoming().totalScore >= existing().totalScore
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'highestUnlockedLevel',
          'totalScore',
          'levels',
          'updatedAt'
        ]);
    }

    // 5. TowerDefenseProfile Validation Blueprint (Vệ Thành Quái Thú)
    function isValidTdUpgrades(up) {
      return up is map
        && up.keys().hasAll(['archery', 'magic', 'barracks', 'economy', 'spells'])
        && up.keys().hasOnly(['archery', 'magic', 'barracks', 'economy', 'spells'])
        && up.archery is int && up.archery >= 0 && up.archery <= 3
        && up.magic is int && up.magic >= 0 && up.magic <= 3
        && up.barracks is int && up.barracks >= 0 && up.barracks <= 3
        && up.economy is int && up.economy >= 0 && up.economy <= 3
        && up.spells is int && up.spells >= 0 && up.spells <= 3;
    }

    function isValidTowerDefenseProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'highestUnlockedLevel',
          'totalScore',
          'levels',
          'upgrades',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'highestUnlockedLevel',
          'totalScore',
          'levels',
          'upgrades',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.highestUnlockedLevel is int
        && data.highestUnlockedLevel >= 1
        && data.highestUnlockedLevel <= 30
        && data.totalScore is int
        && data.totalScore >= 0
        && data.totalScore <= 500000000
        && data.levels is map
        && data.levels.size() <= 30
        && isValidTdUpgrades(data.upgrades)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isTdProgressUpdateAction() {
      return isImmutableProfilePreserved()
        && incoming().highestUnlockedLevel >= existing().highestUnlockedLevel
        && incoming().highestUnlockedLevel <= incoming().levels.size() + 1
        && incoming().totalScore >= existing().totalScore
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'highestUnlockedLevel',
          'totalScore',
          'levels',
          'upgrades',
          'updatedAt'
        ]);
    }

    // 6. Private Per-Player Progression Collections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidPlayerProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidPlayerProfile(incoming(), userId)
        && (
          isSoundToggleAction()
          || isProfileSyncAction()
          || isProgressUpdateAction()
        );

      allow delete: if false;
    }

    match /diamondProgress/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidDiamondProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidDiamondProfile(incoming(), userId)
        && isDiamondProgressUpdateAction();

      allow delete: if false;
    }

    match /towerDefenseProgress/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidTowerDefenseProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidTowerDefenseProfile(incoming(), userId)
        && isTdProgressUpdateAction();

      allow delete: if false;
    }
  }
}
